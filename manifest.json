{
  "manifest_version": 3,
  "name": "AnimatePop",
  "version": "1.0",
  "description": "Plays a transparent cat video at set intervals.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["assets/*.webm", "assets/videos.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
